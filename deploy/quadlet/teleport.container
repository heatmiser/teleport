[Unit]
Description=Teleport Access Plane Container
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/teleport:latest
ContainerName=teleport
AutoUpdate=registry
PublishPort=3022:3022
PublishPort=3023:3023
PublishPort=3024:3024
PublishPort=3025:3025
Volume=/etc/teleport:/etc/teleport:Z
Volume=/var/lib/teleport:/var/lib/teleport:Z
Exec=start -c /etc/teleport/teleport.yaml

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
