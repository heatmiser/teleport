FROM registry.redhat.io/rhel9/postgresql-15:9.8-1788330321

LABEL name="teleport-postgres" \
      summary="PostgreSQL 15 with wal2json extension for Teleport backend"

USER 0

# Disable modular postgresql filter, install PGDG wal2json_15, and symlink wal2json.so into RHEL PostgreSQL lib dir
RUN dnf -qy module disable postgresql && \
    dnf install -y https://download.postgresql.org/pub/repos/yum/reporpms/EL-9.8-x86_64/pgdg-redhat-repo-EL-9.8-latest.noarch.rpm && \
    dnf install -y wal2json_15 && \
    ln -sf /usr/pgsql-15/lib/wal2json.so /usr/lib64/pgsql/wal2json.so && \
    dnf clean all

USER 26
